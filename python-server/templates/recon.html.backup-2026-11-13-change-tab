<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080b12"><title>Recon Studio · Bug Bounty HQ</title>
<style>
:root{color-scheme:dark;--bg:#080b12;--panel:#101722;--panel2:#0c121c;--line:#202c3b;--muted:#8292a8;--text:#edf3fb;--blue:#75a7ff;--green:#57d7a0;--orange:#f4bd68;--red:#ff7189}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 Inter,system-ui,Arial}.shell{max-width:1440px;margin:auto;padding:0 24px}.top{height:66px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.logo{font-weight:850;letter-spacing:.12em;font-size:12px}.logo b{color:var(--green)}a{color:var(--blue);text-decoration:none}.top nav{display:flex;gap:20px;color:var(--muted);font-size:12px}.hero{padding:34px 0 22px;display:flex;justify-content:space-between;align-items:end;gap:20px}.kicker{font-size:10px;letter-spacing:.22em;color:var(--green);text-transform:uppercase}.hero h1{font-size:clamp(30px,5vw,46px);letter-spacing:-.05em;line-height:1.05;margin:8px 0}.hero p{color:var(--muted);margin:0;max-width:650px}.status{border:1px solid var(--line);padding:8px 12px;border-radius:30px;color:var(--muted);font-size:11px;white-space:nowrap}.layout{display:grid;grid-template-columns:330px minmax(0,1fr);gap:16px;padding-bottom:50px}.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;overflow:hidden}.panel-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.panel-head h2{font-size:13px;margin:0}.panel-body{padding:16px}.muted{color:var(--muted)}.tiny{font-size:11px;color:var(--muted)}label{display:block;font-size:11px;color:#aab8ca;margin:12px 0 6px}input,textarea,select{width:100%;background:#090f18;border:1px solid #2a384b;border-radius:8px;padding:10px;color:var(--text);font:13px system-ui;outline:none}input:focus,select:focus{border-color:var(--blue)}.btn{border:0;border-radius:8px;padding:10px 13px;background:#356fe0;color:#fff;font-weight:700;font-size:12px;cursor:pointer}.btn:disabled{opacity:.45;cursor:not-allowed}.btn.ghost{background:#1a2738;color:#cbd9eb;border:1px solid #2a3b50}.btn.full{width:100%;margin-top:14px}.btn.warn{background:#593d1c;color:#ffe0aa}.checkrow{display:flex;gap:8px;align-items:flex-start;margin-top:12px}.checkrow input{width:auto;margin-top:3px}.checkrow label{margin:0;line-height:1.4}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px}.metric{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:13px}.metric small{display:block;color:var(--muted);font-size:10px}.metric strong{font-size:24px;letter-spacing:-.04em}.progress{height:5px;background:#1b2736;border-radius:8px;overflow:hidden;margin:12px 0}.progress i{display:block;height:100%;width:0;background:var(--green);transition:width .3s}.jobline{display:flex;justify-content:space-between;gap:12px;align-items:center}.tabs{display:flex;gap:6px;flex-wrap:wrap;padding:12px 15px;border-bottom:1px solid var(--line)}.tab{border:1px solid transparent;border-radius:7px;background:transparent;color:var(--muted);padding:7px 10px;font-size:11px;cursor:pointer}.tab.active{background:#1a2b42;border-color:#2a4668;color:#d8e8ff}.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:580px}th,td{text-align:left;padding:11px 14px;border-bottom:1px solid #1d2938;font-size:11px}th{color:var(--muted);font-weight:600}td{overflow-wrap:anywhere}.tag{border:1px solid #2d4058;border-radius:30px;padding:3px 7px;font-size:10px;color:#b9cce5}.empty{padding:28px;text-align:center;color:var(--muted);font-size:12px}.jobitem{padding:11px;border:1px solid var(--line);border-radius:9px;margin-top:8px;cursor:pointer}.jobitem.selected{border-color:#4d83d4;background:#132238}.jobitem strong{display:block;font-size:12px}.jobitem small{font-size:10px;color:var(--muted)}.events{max-height:170px;overflow:auto;font:11px/1.6 ui-monospace,monospace;color:#9db0c8}.event{border-bottom:1px solid #1c2938;padding:5px 0}.green{color:var(--green)}.amber{color:var(--orange)}.red{color:var(--red)}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}.notice{border:1px solid #5a492c;background:#30261366;border-radius:9px;padding:10px 12px;color:#e8ca91;font-size:11px;margin-bottom:14px}.rightcol{min-width:0}@media(max-width:850px){.layout{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}.hero{align-items:start;flex-direction:column}.shell{padding:0 14px}.top nav{gap:12px}}@media(max-width:480px){.grid2{grid-template-columns:1fr}.top nav a:nth-child(2){display:none}}
</style></head>
<body><div class="shell"><header class="top"><a class="logo" href="/"><b>ROOT</b>_USER / RECON STUDIO</a><nav><a href="/bounty">Bounty HQ</a><a href="/lab">Cyber Lab</a><a href="/">Home</a></nav></header>
<section class="hero"><div><div class="kicker">Automated asset intelligence</div><h1>Recon Studio<span style="color:var(--green)">.</span></h1><p>Discover, validate and organize public-facing assets. Every active check is constrained to the scope you provide.</p></div><div class="status" id="serviceStatus">● Engine ready</div></section>
<div class="notice">Authorized testing only. You must have permission for every target. Active mode performs low-rate TCP connection checks on a short common-port list plus basic HTTP/TLS checks. No exploitation or destructive tests. Scope is supplied with each job and is not independently verified against a bounty policy.</div>
<div class="layout">
<aside class="panel"><div class="panel-head"><h2>New recon job</h2><span class="tag">Manual launch</span></div><div class="panel-body">
<label for="apiKey">Private recon access key</label><input id="apiKey" type="password" placeholder="Set RECON_API_KEY in Render, then enter it here" autocomplete="off" onchange="loadJobs();loadSchedules()"><div class="tiny">The key is sent only to this server and is not saved in browser storage.</div><label for="target">Root domain</label><input id="target" placeholder="example.com" autocomplete="off">
<label for="scope">Authorized scope entries</label><textarea id="scope" rows="4" placeholder="One per line:&#10;*.example.com&#10;api.example.com"></textarea><div class="tiny">Use *.domain.com for wildcard entries. Exact host entries only match that hostname.</div>
<div class="checkrow"><input id="active" type="checkbox"><label for="active">Enable limited TCP port discovery (common ports only)</label></div>
<div class="checkrow"><input id="confirm" type="checkbox"><label for="confirm">I confirm I am authorized to test these assets and have reviewed the program policy.</label></div>
<button class="btn full" id="startBtn" onclick="startJob()">▶ Queue reconnaissance</button><label for="interval">Repeat this recon</label><select id="interval"><option value="6">Every 6 hours</option><option value="12">Every 12 hours</option><option value="24" selected>Daily</option><option value="168">Weekly</option></select><button class="btn ghost full" onclick="saveSchedule()">＋ Save recurring schedule</button><p class="tiny" id="formMsg">Jobs are stored in PostgreSQL and picked up by GitHub Actions on its next scheduled run.</p><div id="scheduleList" class="tiny" style="margin-top:12px">Loading schedules…</div>
</div><div class="panel-head"><h2>Recent jobs</h2><button class="btn ghost" onclick="loadJobs()">↻</button></div><div class="panel-body" id="jobList"><div class="empty">No recon jobs yet.</div></div></aside>
<section class="rightcol">
<div class="metrics"><div class="metric"><small>Discovered hosts</small><strong id="mHosts">0</strong></div><div class="metric"><small>DNS resolved</small><strong id="mDns">0</strong></div><div class="metric"><small>Web services</small><strong id="mWeb">0</strong></div><div class="metric"><small>Open ports</small><strong id="mPorts">0</strong></div></div>
<div class="panel"><div class="panel-head"><div><h2 id="jobTitle">Recon results</h2><div class="tiny" id="jobMeta">Select a job or start a new one.</div></div><span class="tag" id="jobStatus">IDLE</span></div><div class="panel-body"><div class="jobline"><span class="tiny" id="stage">Waiting for a recon job</span><span class="tiny" id="pct">0%</span></div><div class="progress"><i id="bar"></i></div><div class="actions" style="display:flex;gap:8px;flex-wrap:wrap"><button class="btn ghost" onclick="downloadReport('json')">Export JSON</button><button class="btn ghost" onclick="downloadReport('csv')">Export CSV</button></div></div>
<div class="tabs" id="tabs"><button class="tab active" data-tab="discovered">Hosts</button><button class="tab" data-tab="dns">DNS</button><button class="tab" data-tab="web">Web</button><button class="tab" data-tab="historical_urls">History</button><button class="tab" data-tab="endpoints">Endpoints</button><button class="tab" data-tab="javascript">JavaScript</button><button class="tab" data-tab="ports">Ports</button><button class="tab" data-tab="tls">TLS</button><button class="tab" data-tab="cors">CORS</button><button class="tab" data-tab="checks">Review checks</button><button class="tab" data-tab="network_intel">ASN / IP intel</button><button class="tab" data-tab="domain_intel">WHOIS / RDAP</button><button class="tab" data-tab="events">Activity</button></div>
<div class="tablewrap" id="results"><div class="empty">Your results will appear here.</div></div></div>
<div class="grid2" style="margin-top:14px"><div class="panel"><div class="panel-head"><h2>What this engine checks</h2></div><div class="panel-body tiny">Certificate Transparency · Wayback historical URLs · DNS A/AAAA/CNAME/MX/NS/TXT · RDAP domain details · IP/ASN organization lookups · HTTP/HTTPS · TLS · same-host crawl · JavaScript endpoint references · basic header review · optional limited web-port checks.</div></div><div class="panel"><div class="panel-head"><h2>Runtime limitations</h2></div><div class="panel-body tiny">This first runner keeps jobs in memory. A Render restart or sleep may interrupt jobs and clear history. Scheduled scans and durable cross-restart history need a persistent database and a worker/scheduler service. Export reports after each run.</div></div></div>
</section></div></div>
<script>
let current=null,activeTab='discovered',poll=null;
const $=id=>document.getElementById(id);
async function api(url,opts={}){const headers={'Content-Type':'application/json','X-Recon-Key':$('apiKey').value.trim()};const r=await fetch(url,{headers,...opts});const d=await r.json();if(!r.ok)throw Error(d.error||'Request failed');return d}
function scopeRows(){return $('scope').value.split(/\n+/).map(s=>s.trim()).filter(Boolean).map(s=>({host:s.replace(/^\*\./,''),type:s.startsWith('*.')?'Wildcard domain':'Exact hostname'}))}
async function startJob(){if(!$('confirm').checked){$('formMsg').textContent='Confirm authorization first.';return}const target=$('target').value.trim(),scope=scopeRows();if(!target||!scope.length){$('formMsg').textContent='Enter a root domain and at least one scope entry.';return}
$('startBtn').disabled=true;$('formMsg').textContent='Submitting job…';try{const d=await api('/api/recon/start',{method:'POST',body:JSON.stringify({domain:target,scope,active_ports:$('active').checked})});current=d.job_id;activeTab='discovered';await loadJob();await async function saveSchedule(){
 if(!$('confirm').checked){$('formMsg').textContent='Confirm authorization first.';return}
 const target=$('target').value.trim(),scope=scopeRows();
 if(!target||!scope.length){$('formMsg').textContent='Enter a root domain and scope first.';return}
 try{
  const d=await api('/api/recon/schedules',{method:'POST',body:JSON.stringify({domain:target,scope,active_ports:$('active').checked,interval_hours:Number($('interval').value)})});
  $('formMsg').textContent='Recurring schedule saved. It will run on the next GitHub Actions cycle.';
  await loadSchedules();
 }catch(e){$('formMsg').textContent=e.message}
}
async function loadSchedules(){
 try{
  const d=await api('/api/recon/schedules');
  $('scheduleList').innerHTML=d.schedules.map(s=>'<div class="jobitem"><strong>'+esc(s.domain)+'</strong><small>Every '+s.interval_hours+'h · next '+new Date(s.next_run_at).toLocaleString()+' · '+(s.enabled?'enabled':'paused')+'</small><button class="btn ghost" style="margin-top:7px" data-id="'+esc(s.id)+'" data-enabled="'+(s.enabled?0:1)+'" onclick="toggleSchedule(this.dataset.id,!!Number(this.dataset.enabled))">'+(s.enabled?'Pause':'Enable')+'</button></div>').join('')||'No recurring targets saved.';
 }catch(e){$('scheduleList').textContent=e.message}
}
async function toggleSchedule(id,enabled){
 try{await api('/api/recon/schedules/'+id+'/toggle',{method:'POST',body:JSON.stringify({enabled})});await loadSchedules()}
 catch(e){$('scheduleList').textContent=e.message}
}
loadJobs();loadSchedules();$('formMsg').textContent='Job submitted. Keep this page open while it runs.';if(poll)clearInterval(poll);poll=setInterval(()=>loadJob().catch(()=>{}),8000)}catch(e){$('formMsg').textContent=e.message}finally{$('startBtn').disabled=false}}
async function loadJobs(){try{const d=await api('/api/recon/jobs');$('jobList').innerHTML=d.jobs.map(j=>'<div class="jobitem '+(j.id===current?'selected':'')+'" onclick="selectJob(\''+j.id+'\')"><strong>'+esc(j.domain)+'</strong><small>'+esc(j.status)+' · '+esc(j.stage)+' · '+j.progress+'%</small></div>').join('')||'<div class="empty">No jobs yet.</div>'}catch(e){$('jobList').innerHTML='<div class="empty">'+esc(e.message)+'</div>'}}
async function selectJob(id){current=id;await loadJob();await loadJobs();if(poll)clearInterval(poll);poll=setInterval(()=>loadJob().catch(()=>{}),2500)}
async function loadJob(){if(!current)return;const d=await api('/api/recon/jobs/'+current);const j=d.job;$('jobTitle').textContent=j.domain;$('jobMeta').textContent='Job '+j.id+' · Started '+new Date(j.created_at).toLocaleString();$('jobStatus').textContent=j.status.toUpperCase();$('stage').textContent=j.stage;$('pct').textContent=j.progress+'%';$('bar').style.width=j.progress+'%';const r=j.results||{};$('mHosts').textContent=(r.discovered||[]).length;$('mDns').textContent=(r.hosts||[]).filter(x=>x.ips?.length).length;$('mWeb').textContent=(r.web||[]).length;$('mPorts').textContent=(r.ports||[]).length;renderTab(j);if(['completed','failed'].includes(j.status)){clearInterval(poll);poll=null;loadJobs()}}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function renderTab(j){const rows=j.results?.[activeTab]||[];if(activeTab==='events'){$('results').innerHTML='<div class="panel-body events">'+(j.events||[]).map(e=>'<div class="event"><span class="muted">'+new Date(e.at).toLocaleTimeString()+'</span> <span class="'+(e.level==='error'?'red':'')+'">'+esc(e.message)+'</span></div>').join('')+'</div>';return}
if(!rows.length){$('results').innerHTML='<div class="empty">No '+esc(activeTab)+' results yet.</div>';return}
let cols=Object.keys(rows[0]);$('results').innerHTML='<table><thead><tr>'+cols.map(c=>'<th>'+esc(c.replaceAll('_',' '))+'</th>').join('')+'</tr></thead><tbody>'+rows.map(row=>'<tr>'+cols.map(c=>'<td>'+esc(typeof row[c]==='object'?JSON.stringify(row[c]):row[c])+'</td>').join('')+'</tr>').join('')+'</tbody></table>'}
$('tabs').addEventListener('click',e=>{const b=e.target.closest('[data-tab]');if(!b)return;activeTab=b.dataset.tab;document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));if(current)loadJob()});
async function downloadReport(kind){if(!current){$('formMsg').textContent='Select a completed or running job first.';return}try{const d=await api('/api/recon/jobs/'+current),j=d.job;let blob,name;if(kind==='json'){blob=new Blob([JSON.stringify(j,null,2)],{type:'application/json'});name='recon-'+j.domain+'-'+j.id+'.json'}else{const all=Object.entries(j.results||{}).flatMap(([type,arr])=>arr.map(x=>({category:type,...x})));const keys=[...new Set(all.flatMap(x=>Object.keys(x)))];const csv=[keys.join(','),...all.map(row=>keys.map(k=>'"'+String(row[k]??'').replaceAll('"','""')+'"').join(','))].join('\n');blob=new Blob([csv],{type:'text/csv'});name='recon-'+j.domain+'-'+j.id+'.csv'}const a=document.createElement('a'),u=URL.createObjectURL(blob);a.href=u;a.download=name;a.click();URL.revokeObjectURL(u)}catch(e){$('formMsg').textContent=e.message}}
loadJobs();
</script></body></html>